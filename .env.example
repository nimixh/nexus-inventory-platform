# Application
APP_NAME=Nexus Inventory Platform
APP_VERSION=0.1.0
APP_DEBUG=false

# Database (owner role — used by Alembic migrations only)
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# Database (runtime role — used by the app, RLS enforced)
RUNTIME_DATABASE_URL=postgresql+psycopg://nexus_runtime:nexus_runtime@localhost:5432/nexus

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie
COOKIE_SECURE=true

# Bootstrap seed (required only for first-time Alembic upgrade on a fresh DB)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Celery
# CELERY_BROKER_URL=redis://localhost:6379/0  # defaults to REDIS_URL if unset
# CELERY_RESULT_BACKEND=redis://localhost:6379/0  # defaults to REDIS_URL if unset
